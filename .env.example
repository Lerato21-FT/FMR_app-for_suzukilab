# Copy to .env and edit. .env is gitignored. No secrets are needed today.

# Port on 127.0.0.1 where the app is served.
FMR_PORT=8765

# "simulated" (default, needs no hardware) or "hardware" (real instruments
# through NI-VISA).
FMR_INSTRUMENTS=simulated

# VISA addresses (defaults from the LabVIEW VI).
FMR_SR830_ADDRESS=GPIB0::8::INSTR
FMR_RF_SOURCE_ADDRESS=GPIB0::19::INSTR
FMR_LAKESHORE_ADDRESS=ASRL3::INSTR

# SR830 Aux Out channel that drives the Kepco supply.
FMR_MAGNET_AUX_CHANNEL=1

# Where sweeps are saved, relative to the repository. It must stay inside it.
FMR_DATA_DIR=data/measurements

# Safety limits. Settings outside them are rejected before any command is
# sent. These are placeholders until the lab confirms them (TASKS.md, Q8).
FMR_MAX_AUX_VOLTAGE_V=5.0
FMR_MAX_FIELD_OE=10000
FMR_MAX_RF_POWER_DBM=20
FMR_MAX_RAMP_STEP_V=0.1
FMR_MAX_POINTS_PER_SWEEP=20000
